{
  "name": "seria-ui",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "React panel components, shared tokens, and restrained motion.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "docs",
    "examples",
    "DESIGN-REFERENCES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsc -p tsconfig.json && node copy-css.mjs",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p demo/tsconfig.json && tsc -p showcase/tsconfig.json",
    "check:contrast": "node verify-contrast.mjs",
    "check": "npm run typecheck && npm run check:contrast",
    "format": "prettier --write src demo showcase examples test docs .github *.json *.mjs *.md",
    "format:check": "prettier --check src demo showcase examples test docs .github *.json *.mjs *.md",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "package:release": "node prepare-release.mjs",
    "test:consumer": "npm run package:release && node verify-consumer.mjs"
  },
  "peerDependencies": {
    "@headlessui/react": "^2.2.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "prettier": "3.9.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "author": "Sie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukino-sie/seria-ui.git"
  },
  "homepage": "https://github.com/tsukino-sie/seria-ui#readme",
  "bugs": {
    "url": "https://github.com/tsukino-sie/seria-ui/issues"
  }
}
